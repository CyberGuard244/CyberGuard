# Copia este ficheiro para .env e preenche os valores
# Nunca commitas o ficheiro .env no GitHub

# Chave da Claude API (obtém em console.anthropic.com)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxx

# Ambiente (development ou production)
FLASK_ENV=development
FLASK_DEBUG=1

# Chave secreta do Flask (gera uma aleatória)
SECRET_KEY=altera-esta-chave-para-uma-aleatoria-e-segura
